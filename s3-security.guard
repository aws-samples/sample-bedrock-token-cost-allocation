# cfn-guard rules — S3 bucket security baseline
# Enforces encryption and all four public-access blocks on every
# AWS::S3::Bucket resource in the template under validation.
# Versioning is validated only when explicitly configured (see Rule 1).
#
# Satisfies: Requirements 11.3, 12.4, 12.5

let s3_buckets = Resources.*[ Type == 'AWS::S3::Bucket' ]

# ─────────────────────────────────────────────────────────────────────────────
# Rule 1 — If versioning is configured, it must be Enabled (not Suspended)
# Note: bedrock-firehose-data-lake.yaml omits versioning intentionally (Req 1.6)
# ─────────────────────────────────────────────────────────────────────────────
rule s3_versioning_when_configured when %s3_buckets !empty {
    %s3_buckets[
        Properties.VersioningConfiguration exists
    ].Properties.VersioningConfiguration.Status == "Enabled"
        << When VersioningConfiguration is present, Status must be "Enabled". >>
}

# ─────────────────────────────────────────────────────────────────────────────
# Rule 2 — Server-side encryption must be configured (AES256 or aws:kms)
# ─────────────────────────────────────────────────────────────────────────────
rule s3_encryption_required when %s3_buckets !empty {
    %s3_buckets.Properties.BucketEncryption.ServerSideEncryptionConfiguration[*].ServerSideEncryptionByDefault.SSEAlgorithm IN ["AES256", "aws:kms"]
        << S3 bucket must have BucketEncryption configured with SSEAlgorithm "AES256" or "aws:kms". >>
}

# ─────────────────────────────────────────────────────────────────────────────
# Rule 3 — BlockPublicAcls must be true
# ─────────────────────────────────────────────────────────────────────────────
rule s3_block_public_acls when %s3_buckets !empty {
    %s3_buckets.Properties.PublicAccessBlockConfiguration.BlockPublicAcls == true
        << S3 bucket must have PublicAccessBlockConfiguration.BlockPublicAcls set to true to prevent public ACL-based access. >>
}

# ─────────────────────────────────────────────────────────────────────────────
# Rule 4 — BlockPublicPolicy must be true
# ─────────────────────────────────────────────────────────────────────────────
rule s3_block_public_policy when %s3_buckets !empty {
    %s3_buckets.Properties.PublicAccessBlockConfiguration.BlockPublicPolicy == true
        << S3 bucket must have PublicAccessBlockConfiguration.BlockPublicPolicy set to true to prevent public bucket-policy-based access. >>
}

# ─────────────────────────────────────────────────────────────────────────────
# Rule 5 — IgnorePublicAcls must be true
# ─────────────────────────────────────────────────────────────────────────────
rule s3_ignore_public_acls when %s3_buckets !empty {
    %s3_buckets.Properties.PublicAccessBlockConfiguration.IgnorePublicAcls == true
        << S3 bucket must have PublicAccessBlockConfiguration.IgnorePublicAcls set to true so any public ACLs on objects are ignored. >>
}

# ─────────────────────────────────────────────────────────────────────────────
# Rule 6 — RestrictPublicBuckets must be true
# ─────────────────────────────────────────────────────────────────────────────
rule s3_restrict_public_buckets when %s3_buckets !empty {
    %s3_buckets.Properties.PublicAccessBlockConfiguration.RestrictPublicBuckets == true
        << S3 bucket must have PublicAccessBlockConfiguration.RestrictPublicBuckets set to true to restrict cross-account access to public bucket policies. >>
}

# ─────────────────────────────────────────────────────────────────────────────
# Rule 7 — No Glue Crawler, Job, or Trigger (Firehose template uses inline
# conversion + Partition Projection — no ETL pipeline needed)
# ─────────────────────────────────────────────────────────────────────────────
let glue_crawlers = Resources.*[ Type == 'AWS::Glue::Crawler' ]
let glue_jobs = Resources.*[ Type == 'AWS::Glue::Job' ]
let glue_triggers = Resources.*[ Type == 'AWS::Glue::Trigger' ]

rule no_glue_crawler {
    %glue_crawlers empty
        << AWS::Glue::Crawler is not permitted in this template. Use Athena Partition Projection instead. >>
}

rule no_glue_job {
    %glue_jobs empty
        << AWS::Glue::Job is not permitted. Firehose performs inline JSON-to-Parquet conversion. >>
}

rule no_glue_trigger {
    %glue_triggers empty
        << AWS::Glue::Trigger is not permitted. No ETL job scheduling is needed. >>
}
